# Environment variables for the project. Copy this file to .env and fill in the values.

# OPENMETEO weather API URL
NEXT_PUBLIC_OPENMETEO_API_URL=your-api-url-here

# GitHub credentials for fetching repositories and contributions. Optional but recommended for higher rate limits.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN_PERSONAL=optional_token_for_higher_rate_limit


# If you have multiple GitHub accounts or tokens, you can specify them here for different services. Otherwise, you can leave these as is or remove them.
GITHUB_TOKEN_UPDIKO=optional_token_for_higher_rate_limit
GITHUB_TOKEN_TWOBIT_FORGE=optional_token_for_higher_rate_limit